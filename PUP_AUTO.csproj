<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PUP_AUTO</RootNamespace>
    <AssemblyName>PUP_AUTO</AssemblyName>
    <!-- Helper tools and tests are separate projects; keep them out of the plugin's globs -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tools/**;tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoCAD.NET" Version="24.3.0">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
      <Private>False</Private>
    </PackageReference>
    <PackageReference Include="AutoCAD.NET.Core" Version="24.3.0">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
      <Private>False</Private>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NPOI" Version="2.7.2" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="2.20.0" />
  </ItemGroup>

  <!-- Default reference data (EKATTE register, nomenclatures) compiled into the plugin; a file in the drawing's
       _Templates overrides matching entries. The CSVs in _Templates are the single source. -->
  <ItemGroup>
    <EmbeddedResource Include="_Templates\EKATTE.csv" LogicalName="PUP_AUTO.Defaults.%(Filename)%(Extension)" />
    <EmbeddedResource Include="_Templates\Номенклатури\*.csv" LogicalName="PUP_AUTO.Defaults.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Block definitions imported into a drawing that lacks them (GBP032 corner block), next to the plugin DLL -->
  <ItemGroup>
    <None Include="Resources\Blocks\*.dwg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- WPF assemblies for the GUI (required on .NET Framework 4.8) -->
  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

</Project>
