<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="2.20.0" />
  </ItemGroup>

  <!-- The shipped reference data is tested as it is in _Templates -->
  <ItemGroup>
    <None Include="..\..\_Templates\EKATTE.csv" Link="TestData\EKATTE.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\_Templates\Номенклатури\*.csv" Link="TestData\Номенклатури\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\PUP_AUTO.csproj" />
  </ItemGroup>

</Project>
